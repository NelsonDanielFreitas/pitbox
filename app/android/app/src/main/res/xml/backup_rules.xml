<?xml version="1.0" encoding="utf-8"?>
<!-- Android 10 to 11 (API 29-30): back up nothing. See AndroidManifest.xml and ADR 0033. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
