# Copia gerada por `make init` (que preenche os segredos com `openssl rand` e acrescenta
# as chaves que faltarem, sem tocar nas existentes).
# `make zitadel-provision` acrescenta ainda PITBOX_OIDC_CLIENT_ID e PITBOX_OIDC_CLIENT_SECRET.
# NUNCA commitar o .env. Os valores abaixo ficam vazios de propósito.

# --- Segredos (gerados por `make init`) ---
POSTGRES_SUPERUSER_PASSWORD=
PITBOX_MIGRATOR_PASSWORD=
PITBOX_API_PASSWORD=
ZITADEL_DB_PASSWORD=
OPENFGA_DB_PASSWORD=
OPENFGA_PRESHARED_KEY=
VALKEY_PASSWORD=
VALKEY_API_PASSWORD=          # palavra-passe do utilizador ACL "pitbox_api" (ADR 0013)
ZITADEL_MASTERKEY=            # exatamente 32 caracteres
ZITADEL_LOGIN_COOKIE_SECRET=  # pelo menos 32 caracteres
ZITADEL_ADMIN_USERNAME=
ZITADEL_ADMIN_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Portas (todas publicadas só em 127.0.0.1; omitir = valor por omissão) ---
# POSTGRES_PORT=5432
# VALKEY_PORT=6379
# ZITADEL_PORT=8080
# OPENFGA_HTTP_PORT=8090
# OPENFGA_GRPC_PORT=8091
# JAEGER_UI_PORT=16686
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
# JAEGER_HEALTH_PORT=13133
# S3_PORT=8333

# --- OpenFGA (F1-05) ---
# Em local, PITBOX_OPENFGA_STORE_ID e PITBOX_OPENFGA_MODEL_ID podem ficar vazios:
# o api cria a store e usa o modelo mais recente. Fora de local são obrigatórios.
PITBOX_OPENFGA_ADDR=127.0.0.1:${OPENFGA_HTTP_PORT:-8090}
PITBOX_OPENFGA_PRESHARED_KEY=${OPENFGA_PRESHARED_KEY}
# PITBOX_OPENFGA_STORE_ID=
# PITBOX_OPENFGA_MODEL_ID=
